# URL pública do site, SEM barra no fim (usada em metadados, sitemap, robots,
# URLs canónicos, dados estruturados e imagens de partilha).
# IMPORTANTE: alterar para o teu domínio real antes de publicar.
NEXT_PUBLIC_URL_SITE=https://pauloximana.ao

# ID do formulário Formspree (https://formspree.io) que recebe as mensagens
# do formulário de contacto e as envia para pauloximana@gmail.com.
# 1. Cria uma conta em formspree.io com pauloximana@gmail.com e um novo formulário.
# 2. O Formspree dá-te um endpoint do género https://formspree.io/f/abcd1234
# 3. Copia só a parte final ("abcd1234") para aqui.
# Sem este valor, o formulário abre o programa de email do visitante (alternativa).
NEXT_PUBLIC_FORMSPREE_ID=

# Verificação de propriedade (opcional). Cola só o valor do atributo "content"
# da meta tag que o Google Search Console / Bing Webmaster Tools te der.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
